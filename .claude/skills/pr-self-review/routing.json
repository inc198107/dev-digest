{
  "$comment": "Which skill reviews which changed file, and which checks a change triggers. Globs are repo-relative POSIX paths (** * ? {a,b}). Every skill in .claude/skills must appear in lanes or ignore; plan.mjs reports the ones that do not.",
  "defaultChunk": 25,
  "ignore": ["mermaid-diagram", "engineering-insights", "pr-self-review"],
  "excludeFiles": [
    "**/node_modules/**",
    "**/pnpm-lock.yaml",
    "**/package-lock.json",
    "**/*.tsbuildinfo",
    "server/src/db/migrations/meta/**"
  ],
  "lanes": [
    {
      "skill": "onion-architecture",
      "include": [
        "server/src/**/*.ts",
        "server/test/**/*.ts",
        "reviewer-core/src/**/*.ts",
        "reviewer-core/test/**/*.ts",
        "server/.onion-rings.cjs",
        "server/.dependency-cruiser.cjs"
      ],
      "exclude": ["server/src/db/migrations/**"]
    },
    {
      "skill": "fastify-best-practices",
      "include": [
        "server/src/app.ts",
        "server/src/server.ts",
        "server/src/platform/**/*.ts",
        "server/src/modules/**/routes.ts",
        "server/src/modules/index.ts",
        "server/src/**/*plugin*.ts"
      ]
    },
    {
      "skill": "drizzle-orm-patterns",
      "include": [
        "server/src/db/**/*.ts",
        "server/src/modules/**/repository.ts",
        "server/src/modules/**/repository/**/*.ts",
        "server/drizzle.config.ts"
      ]
    },
    {
      "skill": "postgresql-table-design",
      "include": ["server/src/db/schema.ts", "server/src/db/schema/**/*.ts", "server/src/db/migrations/*.sql"]
    },
    {
      "skill": "zod",
      "include": [
        "server/src/vendor/shared/**/*.ts",
        "client/src/vendor/shared/**/*.ts",
        "server/src/modules/**/schemas.ts",
        "server/src/modules/_shared/schemas.ts"
      ]
    },
    {
      "skill": "frontend-ui-architecture",
      "include": ["client/src/**/*.{ts,tsx}"],
      "exclude": ["client/src/vendor/shared/**"]
    },
    {
      "skill": "react-best-practices",
      "include": ["client/src/**/*.tsx"],
      "exclude": ["client/src/**/*.test.tsx"]
    },
    {
      "skill": "next-best-practices",
      "include": ["client/src/app/**", "client/next.config.*", "client/src/middleware.ts"]
    },
    {
      "skill": "react-testing-library",
      "include": ["client/src/**/*.test.{ts,tsx}", "client/src/test/**/*.{ts,tsx}", "client/vitest.config.ts"]
    },
    {
      "skill": "security",
      "include": [
        "server/src/**/*.ts",
        "reviewer-core/src/**/*.ts",
        "client/src/**/*.{ts,tsx}",
        ".github/workflows/**",
        "docker-compose.yml",
        "scripts/**",
        "**/.env*"
      ],
      "exclude": ["server/src/db/migrations/**"]
    },
    {
      "skill": "typescript-expert",
      "include": ["**/tsconfig*.json", "**/*.d.ts"]
    },
    {
      "skill": "project-rules",
      "builtin": true,
      "instructions": ".claude/skills/pr-self-review/references/project-rules.md",
      "include": ["**"],
      "includeDeleted": true,
      "includeBinary": true,
      "chunk": 150
    }
  ],
  "checks": [
    {
      "id": "onion-boundaries",
      "label": "Onion rings, conventions and @devdigest/shared parity",
      "when": [
        "server/src/**/*.ts",
        "server/test/**/*.ts",
        "reviewer-core/src/**/*.ts",
        "reviewer-core/test/**/*.ts",
        "client/src/vendor/shared/**/*.ts",
        "server/.onion-rings.cjs",
        "server/.dependency-cruiser.cjs",
        "server/.*-known*.json"
      ],
      "cwd": ".",
      "bash": ".claude/skills/onion-architecture/scripts/check-boundaries.sh",
      "requires": ["server/node_modules", ".claude/skills/onion-architecture/scripts/check-boundaries.sh"]
    },
    {
      "id": "server-typecheck",
      "label": "server typecheck",
      "when": ["server/**/*.{ts,cjs,mjs,json}", "reviewer-core/src/**/*.ts"],
      "cwd": "server",
      "command": "pnpm typecheck",
      "requires": ["server/node_modules"]
    },
    {
      "id": "server-unit-tests",
      "label": "server unit tests (hermetic)",
      "when": ["server/**/*.{ts,cjs,mjs,json}", "reviewer-core/src/**/*.ts"],
      "cwd": "server",
      "command": "pnpm exec vitest run --exclude \"**/*.it.test.ts\"",
      "requires": ["server/node_modules"]
    },
    {
      "id": "reviewer-core-typecheck",
      "label": "reviewer-core typecheck",
      "when": ["reviewer-core/**/*.{ts,json}", "server/src/vendor/shared/**/*.ts"],
      "cwd": "reviewer-core",
      "command": "npm run typecheck",
      "requires": ["reviewer-core/node_modules"]
    },
    {
      "id": "reviewer-core-unit-tests",
      "label": "reviewer-core unit tests",
      "when": ["reviewer-core/**/*.{ts,json}", "server/src/vendor/shared/**/*.ts"],
      "cwd": "reviewer-core",
      "command": "npm test",
      "requires": ["reviewer-core/node_modules"]
    },
    {
      "id": "client-typecheck",
      "label": "client typecheck",
      "when": ["client/**/*.{ts,tsx,mjs,json}"],
      "cwd": "client",
      "command": "pnpm typecheck",
      "requires": ["client/node_modules"]
    },
    {
      "id": "client-unit-tests",
      "label": "client unit tests",
      "when": ["client/**/*.{ts,tsx,mjs,json}"],
      "cwd": "client",
      "command": "pnpm test",
      "requires": ["client/node_modules"]
    },
    {
      "id": "e2e-typecheck",
      "label": "e2e typecheck",
      "when": ["e2e/**/*.{ts,json}"],
      "cwd": "e2e",
      "command": "npm run typecheck",
      "requires": ["e2e/node_modules"]
    }
  ]
}
